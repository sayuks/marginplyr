  revenue,
  share_of_parent,
  na.rm = TRUE,
  .names = "\{.col\}_share",
  .unpack = TRUE
)

# Supported
revenue = sum(revenue, na.rm = TRUE)
across(
  revenue,
  share_of_parent,
  .names = "\{.col\}_share",
  .unpack = FALSE
)
}\if{html}{\out{</div>}}


# .keep = TRUE retains original key values inside each detail table.
kept_keys <- nest_by_with_margins(
  january_sales,
  .grouping = rollup(region, store),
  .keep = TRUE
)
east_total <- dplyr::filter(
  kept_keys,
  region == "East",
  store == "Total"
)
east_total$data[[1]][c("region", "store")]


{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/R/marginplyr",
        "~/Library/Caches/org.R-project.R/R/marginplyr"
      ]
    },
    "network": {
      "allowedDomains": [
        "api.github.com",
        "app.codecov.io",
        "bioconductor.org",
        "contributor-covenant.org",
        "cran.r-project.org",
        "github.com",
        "rdatatable.gitlab.io",
        "sayuks.github.io",
        "www.contributor-covenant.org"
      ]
    }
  }
}

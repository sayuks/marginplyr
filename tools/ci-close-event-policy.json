{
  "name": "Allow closed-PR CI retirement",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/retire-pr-ci.yaml"],
      "exclude": []
    }
  },
  "rules": [{
    "type": "restrict_action_events",
    "parameters": {"allowed_events": ["pull_request_target"]}
  }]
}

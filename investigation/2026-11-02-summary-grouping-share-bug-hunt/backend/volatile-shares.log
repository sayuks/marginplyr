<SQL> SELECT k, g, h, "..marginplyr_set_id_1" AS "set", v, p
FROM (
  SELECT
    "..marginplyr_share_partition_1" AS k,
    g,
    h,
    v,
    CASE WHEN ("..marginplyr_set_id_1" IN (3)) THEN 1.0 WHEN NOT ("..marginplyr_set_id_1" IN (3)) THEN (CASE WHEN ((v IS NULL) OR ("..marginplyr_denominator_of_v_1" IS NULL) OR "..marginplyr_denominator_of_v_1" = 0.0) THEN NULL WHEN NOT ((v IS NULL) OR ("..marginplyr_denominator_of_v_1" IS NULL) OR "..marginplyr_denominator_of_v_1" = 0.0) THEN (TRY_CAST(v * 1 AS DOUBLE) / TRY_CAST("..marginplyr_denominator_of_v_1" AS DOUBLE)) END) END AS p,
    "..marginplyr_set_id_1",
    "..marginplyr_parent_original_1",
    "..marginplyr_parent_original_2"
  FROM (
    SELECT
      "..marginplyr_share_partition_1",
      g,
      h,
      v,
      p,
      "..marginplyr_set_id_1",
      "..marginplyr_parent_original_1",
      "..marginplyr_parent_original_2",
      CASE WHEN ("..marginplyr_set_id_1" IN (2)) THEN (MAX(CASE WHEN ("..marginplyr_set_id_1" = 3) THEN v WHEN NOT ("..marginplyr_set_id_1" = 3) THEN NULL END) OVER (PARTITION BY "..marginplyr_share_partition_1")) WHEN NOT ("..marginplyr_set_id_1" IN (2)) THEN "..marginplyr_denominator_of_v_1" END AS "..marginplyr_denominator_of_v_1"
    FROM (
      SELECT
        *,
        MAX(CASE WHEN ("..marginplyr_set_id_1" = 2) THEN v WHEN NOT ("..marginplyr_set_id_1" = 2) THEN NULL END) OVER (PARTITION BY "..marginplyr_share_partition_1", "..marginplyr_parent_original_1") AS "..marginplyr_denominator_of_v_1"
      FROM (
        SELECT
          k AS "..marginplyr_share_partition_1",
          CASE WHEN ("..marginplyr_grouping_1" = 1) THEN 'Total' WHEN NOT ("..marginplyr_grouping_1" = 1) THEN (TRY_CAST(g AS TEXT)) END AS g,
          CASE WHEN ("..marginplyr_grouping_2" = 1) THEN 'Total' WHEN NOT ("..marginplyr_grouping_2" = 1) THEN (TRY_CAST(h AS TEXT)) END AS h,
          v,
          p,
          "..marginplyr_set_id_1",
          "..marginplyr_parent_original_1",
          "..marginplyr_parent_original_2"
        FROM (
          SELECT
            *,
            g AS "..marginplyr_parent_original_1",
            h AS "..marginplyr_parent_original_2"
          FROM (
            SELECT
              k,
              g,
              h,
              random() + 0.1 AS v,
              NULL AS p,
              CASE WHEN GROUPING(g) = 0 AND GROUPING(h) = 0 THEN 1 WHEN GROUPING(g) = 0 AND GROUPING(h) = 1 THEN 2 WHEN GROUPING(g) = 1 AND GROUPING(h) = 1 THEN 3 END AS "..marginplyr_set_id_1",
              GROUPING(g) AS "..marginplyr_grouping_1",
              GROUPING(h) AS "..marginplyr_grouping_2"
            FROM volatile_input
            GROUP BY GROUPING SETS ((k, g, h), (k, g), (k))
          ) AS q01
        ) AS q01
      ) AS q01
    ) AS q01
  ) AS q01
) AS q01

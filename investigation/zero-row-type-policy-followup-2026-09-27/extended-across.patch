--- a/R/grouping-context.R
+++ b/R/grouping-context.R
@@ -398,3 +398,52 @@ grouping_id_sql_expr <- function(vars, con) {
     terms
   )
 }
+
+# PROTOTYPE: name outputs whose entire scalar expression is a grouping helper.
+# Across repeats the same reading over each literal lambda body.
+grouping_output_names <- function(dots, selection_proxy) {
+  unlist(Map(function(dot, name) {
+    expr <- rlang::quo_get_expr(dot)
+    if (!is.null(grouping_helper_name(expr))) {
+      return(name)
+    }
+    if (nzchar(name) || !is_across_call(expr)) {
+      return(character())
+    }
+    env <- rlang::quo_get_env(dot)
+    parsed <- parse_across_arguments(expr)
+    if (parsed$fns_index > 0L) {
+      parsed$call_args[[parsed$fns_index]] <- unparenthesized_value(parsed$fns)
+      expr <- rebuild_static_call(expr, parsed$call_args)
+      parsed <- parse_across_arguments(expr)
+    }
+    fns <- if (is_known_function_list_call(parsed$fns, env)) {
+      static_call_args(parsed$fns)
+    } else {
+      list(parsed$fns)
+    }
+    direct <- vapply(fns, function(fn) {
+      fn <- unparenthesized_value(fn)
+      body <- if (rlang::is_call(fn, "~") && length(fn) == 2L) {
+        fn[[2L]]
+      } else if (rlang::is_call(fn, "function")) {
+        fn[[3L]]
+      } else {
+        return(FALSE)
+      }
+      body <- unparenthesized_value(body)
+      while (rlang::is_call(body, "{") && length(body) == 2L) {
+        body <- unparenthesized_value(body[[2L]])
+      }
+      !is.null(grouping_helper_name(body))
+    }, logical(1))
+    if (!any(direct)) {
+      return(character())
+    }
+    outputs <- known_across_output_names(expr, env, selection_proxy)
+    provenance <- across_output_provenance(
+      expr, env, selection_proxy, outputs, expands_own_names = TRUE
+    )
+    outputs[!is.na(provenance$functions) & direct[provenance$functions]]
+  }, dots, rlang::names2(dots)), use.names = FALSE)
+}

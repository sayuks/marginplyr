AArch64 SQLite-writer-guard

{
uint64_t init=0;
uint64_t alloc=0;
0:X1=init; 0:X3=alloc;
1:X1=init; 1:X3=alloc;
}
 P0                      | P1                         ;
 LDR X7,[X3]             | LDR X8,[X3]                ;
 CBNZ X7,Wdone           | MOV X6,X8                  ;
 MOV X0,#1               | CBNZ X8,Rpublished         ;
 STR X0,[X1]             | B Rdone                    ;
 DMB ISH                 | Rpublished: MOV X8,X1      ;
 STR X0,[X3]             | LDR X8,[X8]                ;
 Wdone: NOP              | DMB ISH                    ;
                         | Rdone: NOP                 ;
exists (1:X6=1 /\ 1:X8=0)
